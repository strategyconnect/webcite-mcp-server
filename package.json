{
  "name": "webcite-mcp-server",
  "version": "1.9.67",
  "mcpName": "co.webcite/webcite",
  "description": "Webcite MCP server for AI apps and agents: parse PDFs, scans and office files to Markdown with OCR, verify claims against sources with verdicts, bind citations to the passages they quote, search sources, and review whole documents and their figures.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "webcite-mcp-server": "./dist/index.js",
    "webcite-mcp": "./dist/index.js",
    "webcite-mcp-http": "./dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "check:guide": "node scripts/check-guide-update.cjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "WEBCITE_MCP_PROFILE=full node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "start:http": "node dist/http-server.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "fact-check",
    "fact-checking",
    "citation",
    "webcite",
    "verification",
    "ai-safety",
    "hallucination-detection",
    "source-verification",
    "cursor",
    "claude-desktop",
    "bindback",
    "citation-verification",
    "document-intelligence",
    "document-extraction",
    "document-parsing",
    "ocr",
    "claim-verification",
    "citations",
    "pdf-extraction",
    "spreadsheet"
  ],
  "author": "Webcite",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/strategyconnect/webcite-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/strategyconnect/webcite-mcp-server/issues"
  },
  "homepage": "https://webcite.co"
}
