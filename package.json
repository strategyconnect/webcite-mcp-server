{
  "name": "webcite-mcp-server",
  "version": "1.9.1",
  "description": "WebCite MCP Server - verify AI claims against authoritative sources, bind quotes back to their source passage, and extract document figures deterministically. Works with any MCP-compatible agent or tool.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "webcite-mcp-server": "./dist/index.js",
    "webcite-mcp": "./dist/index.js",
    "webcite-mcp-http": "./dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "WEBCITE_MCP_PROFILE=full node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "start:http": "node dist/http-server.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "fact-check",
    "fact-checking",
    "citation",
    "webcite",
    "verification",
    "ai-safety",
    "hallucination-detection",
    "source-verification",
    "cursor",
    "claude-desktop",
    "bindback",
    "citation-verification",
    "document-intelligence",
    "document-extraction",
    "pdf-extraction",
    "spreadsheet"
  ],
  "author": "WebCite",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/strategyconnect/webcite-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/strategyconnect/webcite-mcp-server/issues"
  },
  "homepage": "https://webcite.co"
}
